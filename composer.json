{
    "name": "omnishield/turnstile",
    "type": "library",
    "description": "Omnishield Turnstile: Cloudflare's captcha - the widget, and its token checked by Cloudflare's siteverify (the visitor's address, the action and the host checked back, a request retried under its idempotency key).",
    "keywords": [
        "captcha",
        "turnstile",
        "cloudflare",
        "antispam",
        "omnishield"
    ],
    "homepage": "https://github.com/glitchr-studio/omnishield-turnstile",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omniscient/omnishield": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnishield\\Turnstile\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnishield\\Turnstile\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
